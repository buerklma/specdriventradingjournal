<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TradingJournal.ViewModels"
             x:Class="TradingJournal.Views.SettingsView"
             x:DataType="viewmodels:SettingsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Settings" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />

            <!-- Theme Settings -->
            <Frame Padding="20" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Appearance" FontSize="20" FontAttributes="Bold" />

                    <Label Text="Theme" FontAttributes="Bold" />
                    <Picker Title="Select Theme" SelectedItem="{Binding Theme}">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Light</x:String>
                                <x:String>Dark</x:String>
                                <x:String>System</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>
            </Frame>

            <!-- Trading Settings -->
            <Frame Padding="20" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Trading Defaults" FontSize="20" FontAttributes="Bold" />

                    <Label Text="Default Currency" FontAttributes="Bold" />
                    <Entry Text="{Binding DefaultCurrency}" Placeholder="USD" />

                    <Label Text="Default Risk (%)" FontAttributes="Bold" />
                    <Entry Text="{Binding DefaultRiskPercentage}" Placeholder="1.0" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Frame>

            <!-- Security Settings -->
            <Frame Padding="20" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Security" FontSize="20" FontAttributes="Bold" />

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Enable Biometric Authentication" VerticalOptions="Center" />
                        <Switch IsToggled="{Binding EnableBiometricAuth}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Save Button -->
            <Button Text="Save Settings"
                    Command="{Binding SaveSettingsCommand}"
                    BackgroundColor="#4CAF50"
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
