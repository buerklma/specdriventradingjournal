<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TradingJournal.ViewModels"
             x:Class="TradingJournal.Views.TradeDetailView"
             x:DataType="viewmodels:TradeDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <VerticalStackLayout IsVisible="{Binding CurrentTrade, Converter={StaticResource IsNotNullConverter}}" Spacing="15">

                <!-- Symbol and Direction -->
                <Label Text="{Binding CurrentTrade.Symbol}" FontSize="32" FontAttributes="Bold" />
                <Label Text="{Binding CurrentTrade.Direction, StringFormat='Direction: {0}'}" FontSize="18" />

                <!-- Price Information -->
                <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Entry Price:" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CurrentTrade.EntryPrice, StringFormat='{0:F2}'}" FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Stop Loss:" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentTrade.StopLoss, StringFormat='{0:F2}'}" FontAttributes="Bold" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Take Profit:" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding CurrentTrade.TakeProfit, StringFormat='{0:F2}'}" FontAttributes="Bold" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Position Size:" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding CurrentTrade.PositionSize, StringFormat='{0:F2}'}" FontAttributes="Bold" />
                    </Grid>
                </Frame>

                <!-- Performance Metrics (if closed) -->
                <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                       IsVisible="{Binding CurrentTrade.ExitDateTime, Converter={StaticResource IsNotNullConverter}}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Exit Price:" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CurrentTrade.ExitPrice, StringFormat='{0:F2}'}" FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0" Text="P/L:" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentTrade.ProfitLossCurrency, StringFormat='${0:N2}'}" FontAttributes="Bold" />

                        <Label Grid.Row="2" Grid.Column="0" Text="R-Multiple:" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding CurrentTrade.RealizedRRRatio, StringFormat='{0:F2}R'}" FontAttributes="Bold" />
                    </Grid>
                </Frame>

                <!-- Trade Details -->
                <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Trade Details" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding CurrentTrade.SetupType, StringFormat='Setup: {0}'}" />
                        <Label Text="{Binding CurrentTrade.Timeframe, StringFormat='Timeframe: {0}'}" />
                        <Label Text="{Binding CurrentTrade.EntryDateTime, StringFormat='Entry: {0:MMM dd, yyyy HH:mm}'}" />
                        <Label Text="{Binding CurrentTrade.ExitDateTime, StringFormat='Exit: {0:MMM dd, yyyy HH:mm}'}"
                               IsVisible="{Binding CurrentTrade.ExitDateTime, Converter={StaticResource IsNotNullConverter}}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Notes -->
                <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
                       IsVisible="{Binding CurrentTrade.Notes, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Notes" FontSize="16" FontAttributes="Bold" />
                        <Label Text="{Binding CurrentTrade.Notes}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                    <Button Grid.Column="0" Text="Save" Command="{Binding SaveTradeCommand}" />
                    <Button Grid.Column="1" Text="Delete" Command="{Binding DeleteTradeCommand}" BackgroundColor="#F44336" />
                </Grid>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
