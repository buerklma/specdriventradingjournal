<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TradingJournal.ViewModels"
             xmlns:models="clr-namespace:TradingJournal.Data.Models;assembly=TradingJournal.Data"
             x:Class="TradingJournal.Views.AdjustmentsView"
             x:DataType="viewmodels:AdjustmentsViewModel"
             Title="{Binding Title}">

    <Grid Padding="20" RowDefinitions="Auto,*,Auto" RowSpacing="20">

        <!-- Header -->
        <Label Text="Trade Adjustments"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Grid.Row="0" />

        <!-- Adjustments List -->
        <Frame Padding="0"
               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
               Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Adjustments}" Spacing="10" Padding="10">
                    <BindableLayout.EmptyView>
                        <Label Text="No adjustments recorded yet."
                               TextColor="Gray"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="20" />
                    </BindableLayout.EmptyView>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ManagementAdjustment">
                            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding AdjustmentType}" FontAttributes="Bold" />
                                        <Label Text="{Binding AdjustmentDateTime, StringFormat='{0:MMM dd, yyyy HH:mm}'}"
                                               TextColor="Gray"
                                               FontSize="12" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="Previous:" TextColor="Gray" />
                                        <Label Text="{Binding PreviousValue}" />
                                        <Label Text="→" TextColor="Gray" />
                                        <Label Text="New:" TextColor="Gray" />
                                        <Label Text="{Binding NewValue}" FontAttributes="Bold" />
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding Reason}"
                                           FontSize="12"
                                           TextColor="Gray"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Frame>

        <!-- Add Adjustment Form -->
        <Frame Padding="20"
               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
               Grid.Row="2">
            <VerticalStackLayout Spacing="15">
                <Label Text="Add New Adjustment" FontSize="18" FontAttributes="Bold" />

                <Picker Title="Adjustment Type" SelectedItem="{Binding NewAdjustmentType}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>StopLoss</x:String>
                            <x:String>TakeProfit</x:String>
                            <x:String>PositionSize</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                    <DatePicker Date="{Binding NewAdjustmentDateTime}" Grid.Column="0" />
                    <TimePicker Time="{Binding NewAdjustmentDateTime, Converter={StaticResource DateTimeToTimeSpanConverter}}" Grid.Column="1" />
                </Grid>

                <Entry Text="{Binding NewPreviousValue}" Placeholder="Previous Value" Keyboard="Numeric" />
                <Entry Text="{Binding NewValue}" Placeholder="New Value" Keyboard="Numeric" />
                <Entry Text="{Binding NewReason}" Placeholder="Reason for adjustment..." />

                <Button Text="Add Adjustment"
                        Command="{Binding AddAdjustmentCommand}"
                        BackgroundColor="#4CAF50" />
            </VerticalStackLayout>
        </Frame>

    </Grid>

</ContentPage>
