<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TradingJournal.ViewModels"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="TradingJournal.Views.AnalyticsView"
             x:DataType="viewmodels:AnalyticsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Analytics" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />

            <Button Text="Load Analytics"
                    Command="{Binding LoadAnalyticsCommand}"
                    HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <!-- Performance Metrics -->
            <Frame Padding="15" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Label Grid.Row="0" Grid.Column="0" Text="Win Rate:" FontAttributes="Bold" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding WinRate, StringFormat='{0:F2}%'}" />

                    <Label Grid.Row="1" Grid.Column="0" Text="Profit Factor:" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding ProfitFactor, StringFormat='{0:F2}'}" />

                    <Label Grid.Row="2" Grid.Column="0" Text="Avg R-Multiple:" FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding AverageRMultiple, StringFormat='{0:F2}R'}" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Max Drawdown:" FontAttributes="Bold" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding MaxDrawdown, StringFormat='{0:F2}%'}" />
                </Grid>
            </Frame>

            <!-- Equity Curve Chart -->
            <Frame Padding="10" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}" HeightRequest="350">
                <VerticalStackLayout>
                    <Label Text="Equity Curve" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10" />
                    <chart:SfCartesianChart>
                        <chart:SfCartesianChart.XAxes>
                            <chart:DateTimeAxis />
                        </chart:SfCartesianChart.XAxes>

                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis />
                        </chart:SfCartesianChart.YAxes>

                        <chart:SfCartesianChart.Series>
                            <chart:LineSeries ItemsSource="{Binding EquityCurveData}"
                                             XBindingPath="Item1"
                                             YBindingPath="Item2"
                                             Fill="#4CAF50"
                                             StrokeWidth="2"
                                             EnableTooltip="True"
                                             Label="Equity">
                            </chart:LineSeries>
                        </chart:SfCartesianChart.Series>

                        <chart:SfCartesianChart.Legend>
                            <chart:ChartLegend />
                        </chart:SfCartesianChart.Legend>
                    </chart:SfCartesianChart>
                </VerticalStackLayout>
            </Frame>

            <!-- R/R Distribution Chart -->
            <Frame Padding="10" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}" HeightRequest="350">
                <VerticalStackLayout>
                    <Label Text="Risk/Reward Distribution" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10" />
                    <chart:SfCartesianChart>
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis />
                        </chart:SfCartesianChart.XAxes>

                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis />
                        </chart:SfCartesianChart.YAxes>

                        <chart:SfCartesianChart.Series>
                            <chart:ColumnSeries ItemsSource="{Binding RrDistributionData}"
                                               XBindingPath="Item1"
                                               YBindingPath="Item2"
                                               Fill="#2196F3"
                                               EnableTooltip="True"
                                               Label="Trades">
                            </chart:ColumnSeries>
                        </chart:SfCartesianChart.Series>

                        <chart:SfCartesianChart.Legend>
                            <chart:ChartLegend />
                        </chart:SfCartesianChart.Legend>
                    </chart:SfCartesianChart>
                </VerticalStackLayout>
            </Frame>

            <!-- Performance by Setup Chart -->
            <Frame Padding="10" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}" HeightRequest="350">
                <VerticalStackLayout>
                    <Label Text="Performance by Setup Type" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10" />
                    <chart:SfCartesianChart>
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis />
                        </chart:SfCartesianChart.XAxes>

                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis />
                        </chart:SfCartesianChart.YAxes>

                        <chart:SfCartesianChart.Series>
                            <chart:ColumnSeries ItemsSource="{Binding PerformanceBySetupData}"
                                               XBindingPath="Item1"
                                               YBindingPath="Item2"
                                               EnableTooltip="True"
                                               Label="P/L"
                                               Fill="#4CAF50">
                            </chart:ColumnSeries>
                        </chart:SfCartesianChart.Series>

                        <chart:SfCartesianChart.Legend>
                            <chart:ChartLegend />
                        </chart:SfCartesianChart.Legend>
                    </chart:SfCartesianChart>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
