<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TradingJournal.ViewModels"
             x:Class="TradingJournal.Views.DashboardView"
             x:DataType="viewmodels:DashboardViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Trading Dashboard"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Refresh Button -->
            <Button Text="Refresh Statistics"
                    Command="{Binding LoadStatisticsCommand}"
                    HorizontalOptions="Center"
                    WidthRequest="200" />

            <!-- Activity Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              HorizontalOptions="Center" />

            <!-- Statistics Cards Grid -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="15"
                  RowSpacing="15"
                  IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">

                <!-- Total Trades Card -->
                <Frame Grid.Row="0" Grid.Column="0"
                       BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
                       CornerRadius="10"
                       Padding="20"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Total Trades"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />
                        <Label Text="{Binding TotalTrades}"
                               FontSize="36"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Win Rate Card -->
                <Frame Grid.Row="0" Grid.Column="1"
                       BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
                       CornerRadius="10"
                       Padding="20"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Win Rate"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />
                        <Label Text="{Binding WinRate, StringFormat='{0:F2}%'}"
                               FontSize="36"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#4CAF50" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Total P/L Card -->
                <Frame Grid.Row="1" Grid.Column="0"
                       BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
                       CornerRadius="10"
                       Padding="20"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Total P/L"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />
                        <Label Text="{Binding TotalProfitLoss, StringFormat='${0:N2}'}"
                               FontSize="36"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Max Drawdown Card -->
                <Frame Grid.Row="1" Grid.Column="1"
                       BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
                       CornerRadius="10"
                       Padding="20"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Max Drawdown"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />
                        <Label Text="{Binding MaxDrawdown, StringFormat='{0:F2}%'}"
                               FontSize="36"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#F44336" />
                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <!-- Additional Metrics -->
            <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
                   CornerRadius="10"
                   Padding="20"
                   HasShadow="True"
                   IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Performance Metrics"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Profit Factor:"
                               FontSize="16" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding ProfitFactor, StringFormat='{0:F2}'}"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Average R-Multiple:"
                               FontSize="16" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding AverageRMultiple, StringFormat='{0:F2}R'}"
                               FontSize="16"
                               FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
