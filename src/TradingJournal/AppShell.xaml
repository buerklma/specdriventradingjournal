<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TradingJournal.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TradingJournal"
    xmlns:views="clr-namespace:TradingJournal.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="Trading Journal">

    <!-- Flyout Menu Items -->
    <FlyoutItem Title="Dashboard" Icon="dashboard.png">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardView}" Route="Dashboard" />
    </FlyoutItem>

    <FlyoutItem Title="Trades" Icon="trades.png">
        <ShellContent ContentTemplate="{DataTemplate views:TradesListView}" Route="TradesList" />
    </FlyoutItem>

    <FlyoutItem Title="Analytics" Icon="analytics.png">
        <ShellContent ContentTemplate="{DataTemplate views:AnalyticsView}" Route="Analytics" />
    </FlyoutItem>

    <FlyoutItem Title="Export" Icon="export.png">
        <ShellContent ContentTemplate="{DataTemplate views:ExportView}" Route="Export" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Icon="settings.png">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsView}" Route="Settings" />
    </FlyoutItem>

</Shell>
